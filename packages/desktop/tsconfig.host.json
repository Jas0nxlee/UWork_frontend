{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsup 会清理 out/host；声明缓存独立保存，类型检查也不覆盖已打包的 Host JS。
    "outDir": "../../.cache/types/desktop-host",
    "emitDeclarationOnly": true,
    "rootDir": "src/host",
    "lib": ["es2025"]
  },
  "include": ["src/host"],
  // host 既直接依赖 services/shared，也直接 import 了 rpc；补 references 是为了避免它再次把 rpc 源码拉进来检查。
  "references": [{ "path": "../shared" }, { "path": "../services" }, { "path": "../rpc" }]
}
