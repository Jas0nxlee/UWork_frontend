          "properties": {
            "inputFormat": {
              "supportsImage": true,
              "supportsVideo": true
            }
          }
        }
      },
      {
        "modelMatch": ".*",
        "baseUrlMatch": "https://open\\.bigmodel\\.cn/api/anthropic/?",
